# Copy to .env.local (development) or set these in the host's environment
# (production). Never commit a filled-in copy.
#
# Generate both admin values with:
#     npm run hash-password -- "your-password"

# scrypt hash of the control-panel password. The plaintext is never stored.
ADMIN_PASSWORD_HASH=

# Long random string signing the admin session cookie and the downloads gate
# cookie. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Public origin. Drives canonical URLs, the sitemap, robots.txt and JSON-LD.
# MUST be the real https:// origin in production, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://agbacorp.com

# Production only. Node must run in production mode for secure cookies and
# optimised rendering; most hosts set this for you.
NODE_ENV=production
